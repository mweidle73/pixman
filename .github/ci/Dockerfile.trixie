FROM debian:trixie

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    autoconf \
    automake \
    gcc \
    libc6-dev \
    libpng-dev \
    libtool \
    make \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY . /source

# Regenerate the Autotools files so the historical source is tested against
# the toolchain that future maintainers will actually use.
RUN cd /source && NOCONFIGURE=1 ./autogen.sh

WORKDIR /work

CMD ["/bin/sh"]
